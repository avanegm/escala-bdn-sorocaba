# Banco de dados (PostgreSQL do Supabase, usado pelo Prisma)
# DATABASE_URL: conexão via pooler (usada em runtime)
# DIRECT_URL: conexão direta (usada pelo Prisma Migrate)
DATABASE_URL=""
DIRECT_URL=""

# Supabase (projeto criado no dashboard — banco, Auth e Storage habilitados)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cron interno (Vercel Cron chama /api/cron/* com este header secreto)
CRON_SECRET=""

# E-mail transacional (Resend)
RESEND_API_KEY=""

# URL pública da aplicação (usada em links de e-mail, ex: confirmação de presença)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
