generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id          String       @id @db.Uuid
  nome        String
  email       String       @unique
  papelGlobal PapelGlobal? @map("papel_global")
  ativo       Boolean      @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  escalas            EscalaParticipante[]
  logsAuditoria      LogAuditoria[]
  vinculosMinisterio UsuarioMinisterio[]

  @@index([papelGlobal])
  @@map("usuarios")
}

model Ministerio {
  id      String  @id @default(uuid()) @db.Uuid
  nome    String  @unique
  logoUrl String? @map("logo_url")
  ativo   Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  escalas          Escala[]
  vinculosUsuarios UsuarioMinisterio[]

  @@index([ativo])
  @@map("ministerios")
}

model UsuarioMinisterio {
  id String @id @default(uuid()) @db.Uuid

  usuarioId    String @map("usuario_id") @db.Uuid
  ministerioId String @map("ministerio_id") @db.Uuid

  papel PapelMinisterio

  criadoEm DateTime @default(now()) @map("criado_em")

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ministerio Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ministerioId], name: "usuario_ministerio_unico")
  @@index([usuarioId])
  @@index([ministerioId])
  @@map("usuarios_ministerios")
}

model Culto {
  id String @id @default(uuid()) @db.Uuid

  dataHoraCulto DateTime @unique @map("data_hora_culto")

  nome String?

  tipo TipoCulto

  status StatusCulto @default(PLANEJADO)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  escalas Escala[]

  @@index([tipo])
  @@index([status])
  @@map("cultos")
}

model CultoRegular {
  id String @id @default(uuid()) @db.Uuid

  nome String

  diaSemana DiaSemana

  horario String

  ativo Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ativo])
  @@map("cultos_regulares")
}

model Escala {
  id String @id @default(uuid()) @db.Uuid

  cultoId      String @map("culto_id") @db.Uuid
  ministerioId String @map("ministerio_id") @db.Uuid

  ordem Int @default(0)

  observacao String?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  culto      Culto      @relation(fields: [cultoId], references: [id], onDelete: Cascade)
  ministerio Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)

  participantes EscalaParticipante[]

  @@unique([cultoId, ministerioId])
  @@index([cultoId])
  @@index([ministerioId])
  @@map("escalas")
}

model EscalaParticipante {
  id String @id @default(uuid()) @db.Uuid

  escalaId  String @map("escala_id") @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  escala  Escala  @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([escalaId, usuarioId])
  @@index([escalaId])
  @@index([usuarioId])
  @@map("escalas_participantes")
}

model ConfiguracaoSistema {
  id Int @id @default(1)

  diasAntesBloquearAlteracoes Int @default(1) @map("dias_antes_bloquear_alteracoes")

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracoes_sistema")
}

model LogAuditoria {
  id String @id @default(uuid()) @db.Uuid

  usuarioId String? @map("usuario_id") @db.Uuid

  acao AcaoAuditoria

  entidadeAfetada String @map("entidade_afetada")

  entidadeId String? @map("entidade_id")

  detalhes Json?

  criadoEm DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidadeAfetada, entidadeId])
  @@index([criadoEm])
  @@map("logs_auditoria")
}

enum PapelGlobal {
  ADMIN
  SECRETARIO
}

enum PapelMinisterio {
  LIDER
  MEMBRO
}

enum TipoCulto {
  REGULAR
  EXTRAORDINARIO
}

enum StatusCulto {
  PLANEJADO
  PUBLICADO
  FINALIZADO
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

enum AcaoAuditoria {
  CRIACAO_USUARIO
  EDICAO_USUARIO
  EXCLUSAO_USUARIO

  CRIACAO_MINISTERIO
  EDICAO_MINISTERIO
  EXCLUSAO_MINISTERIO

  INCLUSAO_MEMBRO_MINISTERIO
  REMOCAO_MEMBRO_MINISTERIO
  DEFINICAO_LIDER

  CRIACAO_CULTO_REGULAR
  EDICAO_CULTO_REGULAR
  EXCLUSAO_CULTO_REGULAR

  GERACAO_PROXIMO_MES

  ALTERACAO_CONFIGURACAO

  EDICAO_ESCALA_EM_NOME_DE
}
